{
  "paths": {
    "/pacientes": {
      "post": {
        "operationId": "createPatient",
        "tags": [
          "pacientes"
        ],
        "summary": "Registrar paciente, historia y datos dependientes",
        "description": "Crea paciente e historia única; opcionalmente incorpora contactos y antecedentes en una sola transacción. La historia se abre con CURRENT_DATE. Se requiere pacientes/crear con alcance global; los antecedentes requieren además antecedentes/crear global. Recepción puede registrar datos administrativos y contactos. No se aceptan identificadores ni se crea una cuenta de usuario. Una falla en cualquier inserción o en COMMIT revierte toda la operación.",
        "x-owner": "Erick",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Paciente e historia confirmados con los registros dependientes enviados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesAlta"
                }
              }
            }
          },
          "400": {
            "description": "Datos personales, fechas o registros dependientes inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso para el alta o para los antecedentes enviados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe un paciente con el mismo tipo y número de documento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "500": {
            "description": "Fallo al registrar o confirmar; la operación completa se revierte.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pacientesAltaInput"
              },
              "example": {
                "tipo_documento": "DNI",
                "numero_documento": "99120001",
                "nombres": "Paciente",
                "apellidos": "De prueba",
                "telefono": "900120001",
                "contactos": [
                  {
                    "nombre": "Familiar de prueba",
                    "parentesco": "Hermana",
                    "telefono": "900120002"
                  }
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listPatients",
        "tags": [
          "pacientes"
        ],
        "summary": "Buscar y listar pacientes",
        "description": "Devuelve información administrativa con paginación. El alcance global, propio o asignado se obtiene de la sesión y limita tanto los registros como el total. La búsqueda q es literal, ignora mayúsculas y consulta nombres, apellidos o documento; los filtros de documento son exactos.",
        "x-owner": "Erick",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          },
          {
            "in": "query",
            "name": "tipo_documento",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
          {
            "in": "query",
            "name": "numero_documento",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          {
            "in": "query",
            "name": "pagina",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limite",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de pacientes autorizados; una página sin resultados conserva el total.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesPagina"
                }
              }
            }
          },
          "400": {
            "description": "Filtros o identificador inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "403": {
            "description": "Acceso no autorizado al recurso solicitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "500": {
            "description": "No fue posible completar la consulta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          }
        }
      }
    },
    "/pacientes/{id}": {
      "get": {
        "operationId": "getPatient",
        "tags": [
          "pacientes"
        ],
        "summary": "Consultar datos administrativos de un paciente",
        "description": "Devuelve datos personales y sus contactos. Excluye observaciones clínicas, antecedentes y cuestionario. Los permisos y la titularidad se validan antes de consultar; para accesos restringidos puede devolverse 403 sin revelar la existencia del paciente.",
        "x-owner": "Erick",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Identificador bigint representado como texto para conservar su precisión."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos administrativos y contactos del paciente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesDetalle"
                }
              }
            }
          },
          "400": {
            "description": "Filtros o identificador inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "403": {
            "description": "Acceso no autorizado al recurso solicitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "404": {
            "description": "Paciente no encontrado dentro del alcance autorizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "500": {
            "description": "No fue posible completar la consulta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updatePatient",
        "tags": [
          "pacientes"
        ],
        "summary": "Actualizar datos administrativos y contactos de un paciente",
        "description": "Modifica únicamente los campos enviados. null limpia los datos opcionales; no se aceptan identificadores de paciente, historia ni antecedentes. Los contactos con id_contacto deben pertenecer al paciente y pueden modificarse parcialmente; los nuevos requieren nombre, parentesco y teléfono. El paciente se bloquea durante la transacción para coordinar cambios concurrentes. Se aplica el alcance autorizado por Seguridad.",
        "x-owner": "Erick",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Identificador bigint representado como texto para conservar su precisión."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos administrativos y todos los contactos tras confirmar los cambios.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesDetalle"
                }
              }
            }
          },
          "400": {
            "description": "Datos o identificadores inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "403": {
            "description": "Permiso o alcance insuficiente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "404": {
            "description": "Paciente no disponible o contacto inexistente/ajeno al paciente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "409": {
            "description": "El tipo y número de documento ya pertenecen a otro paciente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "500": {
            "description": "No se confirmó la operación; los cambios se revierten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pacientesModificacion"
              },
              "example": {
                "telefono": "900130001",
                "contactos": [
                  {
                    "id_contacto": "1",
                    "telefono": "900130002"
                  },
                  {
                    "nombre": "Familiar de prueba",
                    "parentesco": "Hermana",
                    "telefono": "900130003"
                  }
                ]
              }
            }
          }
        }
      }
    },
