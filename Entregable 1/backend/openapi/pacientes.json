    "/pacientes/{id}/contactos/{contactoId}": {
      "delete": {
        "operationId": "deleteContact",
        "tags": [
          "pacientes"
        ],
        "summary": "Eliminar un contacto del paciente",
        "description": "Comprueba el permiso contactos/eliminar, el alcance y la pertenencia del contacto. Elimina únicamente el contacto indicado, preservando al paciente, su historia y sus antecedentes. Un contacto ya eliminado devuelve 404 para acceso global; la autorización restringida puede devolver 403 sin revelar su existencia.",
        "x-owner": "Erick",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Identificador bigint representado como texto para conservar su precisión."
            }
          },
          {
            "in": "path",
            "name": "contactoId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Identificador bigint representado como texto para conservar su precisión."
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contacto eliminado; respuesta sin cuerpo."
          },
          "400": {
            "description": "Datos o identificadores inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "403": {
            "description": "Permiso o alcance insuficiente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
          },
          "404": {
            "description": "Paciente no disponible o contacto inexistente/ajeno al paciente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pacientesError"
                }
              }
            }
