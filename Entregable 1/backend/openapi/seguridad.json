{
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": [
          "seguridad"
        ],
        "summary": "Iniciar sesión",
        "description": "Verifica la contraseña y el estado de la cuenta. Devuelve un token de sesión y la identidad del titular.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/seguridadLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadSesion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/seguridadEntrada"
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          },
          "503": {
            "$ref": "#/components/responses/seguridadConfiguracion"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "seguridad"
        ],
        "summary": "Consultar la sesión",
        "description": "Devuelve el titular y los permisos asociados al rol actual. El acceso administrativo se reserva al rol Administrador.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadIdentidadYPermisos"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          },
          "503": {
            "$ref": "#/components/responses/seguridadConfiguracion"
          }
        }
      }
    },
    "/roles": {
      "get": {
        "operationId": "listRoles",
        "tags": [
          "seguridad"
        ],
        "summary": "Listar roles",
        "description": "Incluye las asociaciones de permisos de cada rol. Requiere una cuenta administradora.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadRoles"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      }
    },
    "/permisos": {
      "get": {
        "operationId": "listPermissions",
        "tags": [
          "seguridad"
        ],
        "summary": "Listar permisos",
        "description": "Devuelve recursos, acciones y alcances configurables. Requiere una cuenta administradora.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadPermisos"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      }
    },
    "/usuarios": {
      "post": {
        "operationId": "createUser",
        "tags": [
          "seguridad"
        ],
        "summary": "Crear una cuenta",
        "description": "El titular debe existir y corresponder al tipo de rol. El servidor solo almacena el hash de la contraseña.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/seguridadAltaUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadUsuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/seguridadEntrada"
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "404": {
            "$ref": "#/components/responses/seguridadInexistente"
          },
          "409": {
            "$ref": "#/components/responses/seguridadConflicto"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      },
      "get": {
        "operationId": "listUsers",
        "tags": [
          "seguridad"
        ],
        "summary": "Listar cuentas",
        "description": "Lista cuentas ordenadas por identificador ascendente. Admite búsqueda literal en el nombre de acceso, correo o titular.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 254,
              "minLength": 1
            },
            "description": "Texto de búsqueda."
          },
          {
            "name": "id_rol",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/seguridadId"
            },
            "description": "Filtrar por rol."
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "activo",
                "inactivo"
              ]
            },
            "description": "Filtrar por estado."
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            },
            "description": "Página a partir de uno."
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Número máximo de resultados por página."
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadUsuarios"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/seguridadEntrada"
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      }
    },
    "/usuarios/{id}": {
      "patch": {
        "operationId": "updateUser",
        "tags": [
          "seguridad"
        ],
        "summary": "Actualizar una cuenta",
        "description": "Cambia los campos editables. Cambiar la contraseña revoca los tokens anteriores. La cuenta conserva su titular y debe quedar al menos un administrador activo.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/seguridadId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/seguridadCambioUsuario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadUsuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/seguridadEntrada"
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "404": {
            "$ref": "#/components/responses/seguridadInexistente"
          },
          "409": {
            "$ref": "#/components/responses/seguridadConflicto"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      }
    },
    "/roles/{id}/permisos": {
      "put": {
        "operationId": "replaceRolePermissions",
        "tags": [
          "seguridad"
        ],
        "summary": "Reemplazar los permisos de un rol",
        "description": "Valida el conjunto de IDs y lo reemplaza en una transacción. Una lista vacía elimina todas las asociaciones del rol.",
        "x-owner": "Nayemy",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/seguridadId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/seguridadReemplazo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seguridadPermisosDelRol"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/seguridadEntrada"
          },
          "401": {
            "$ref": "#/components/responses/seguridadSesion"
          },
          "403": {
            "$ref": "#/components/responses/seguridadPermiso"
          },
          "404": {
            "$ref": "#/components/responses/seguridadInexistente"
          },
          "500": {
            "$ref": "#/components/responses/seguridadInterno"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "seguridadId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$",
        "description": "Identificador positivo hasta 9223372036854775807, serializado sin pérdida de precisión."
      },
      "seguridadLogin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "correo": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "nombre_acceso": {
            "type": "string",
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Campo enviado por el formulario. Admite un correo o un nombre de acceso."
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "format": "password",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "password"
        ],
        "oneOf": [
          {
            "required": [
              "correo"
            ]
          },
          {
            "required": [
              "nombre_acceso"
            ]
          },
          {
            "required": [
              "email"
            ]
          }
        ]
      },
      "seguridadIdentidad": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idUsuario": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "idRol": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMINISTRADOR",
              "RECEPCIONISTA",
              "ODONTOLOGO",
              "ASISTENTE",
              "PACIENTE"
            ]
          },
          "idEmpleado": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "idPaciente": {
            "$ref": "#/components/schemas/seguridadId"
          }
        },
        "required": [
          "idUsuario",
          "idRol",
          "name",
          "role"
        ]
      },
      "seguridadSesion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT de sesión con una vigencia de una hora."
          },
          "user": {
            "$ref": "#/components/schemas/seguridadIdentidad"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "seguridadIdentidadYPermisos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/seguridadIdentidad"
          },
          "permisos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadPermiso"
            }
          }
        },
        "required": [
          "user",
          "permisos"
        ]
      },
      "seguridadPermiso": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id_permiso": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "recurso": {
            "type": "string",
            "maxLength": 80
          },
          "accion": {
            "type": "string",
            "maxLength": 40
          },
          "alcance": {
            "type": "string",
            "enum": [
              "global",
              "propio",
              "asignado"
            ]
          }
        },
        "required": [
          "id_permiso",
          "recurso",
          "accion",
          "alcance"
        ]
      },
      "seguridadRol": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id_rol": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "nombre": {
            "type": "string",
            "maxLength": 60
          },
          "descripcion": {
            "type": [
              "string",
              "null"
            ]
          },
          "permisos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadPermiso"
            }
          }
        },
        "required": [
          "id_rol",
          "nombre",
          "descripcion",
          "permisos"
        ]
      },
      "seguridadUsuario": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id_usuario": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "nombre_acceso": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "correo": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ]
          },
          "id_rol": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "rol": {
            "type": "string",
            "maxLength": 60
          },
          "id_empleado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/seguridadId"
              },
              {
                "type": "null"
              }
            ]
          },
          "id_paciente": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/seguridadId"
              },
              {
                "type": "null"
              }
            ]
          },
          "titular": {
            "type": "string"
          }
        },
        "required": [
          "id_usuario",
          "nombre_acceso",
          "correo",
          "estado",
          "id_rol",
          "rol",
          "id_empleado",
          "id_paciente",
          "titular"
        ]
      },
      "seguridadAltaUsuario": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre_acceso": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "correo": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "format": "password",
            "minLength": 12,
            "writeOnly": true
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ],
            "default": "activo"
          },
          "id_rol": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/seguridadId"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ]
          },
          "id_empleado": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/seguridadId"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "id_paciente": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/seguridadId"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "nombre_acceso",
          "correo",
          "password",
          "id_rol"
        ],
        "oneOf": [
          {
            "required": [
              "id_empleado"
            ],
            "properties": {
              "id_empleado": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/seguridadId"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                ]
              },
              "id_paciente": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "id_paciente"
            ],
            "properties": {
              "id_paciente": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/seguridadId"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                ]
              },
              "id_empleado": {
                "type": "null"
              }
            }
          }
        ]
      },
      "seguridadCambioUsuario": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre_acceso": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "correo": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "format": "password",
            "minLength": 12,
            "writeOnly": true
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ]
          },
          "id_rol": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/seguridadId"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "required": [],
        "minProperties": 1
      },
      "seguridadUsuarios": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadUsuario"
            }
          },
          "pagina": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          },
          "limite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        "required": [
          "items",
          "pagina",
          "limite"
        ]
      },
      "seguridadRoles": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadRol"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "seguridadPermisos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadPermiso"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "seguridadReemplazo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ids_permiso": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/seguridadId"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              ]
            },
            "uniqueItems": true,
            "maxItems": 250
          }
        },
        "required": [
          "ids_permiso"
        ]
      },
      "seguridadPermisosDelRol": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id_rol": {
            "$ref": "#/components/schemas/seguridadId"
          },
          "ids_permiso": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/seguridadId"
            },
            "uniqueItems": true,
            "maxItems": 250
          }
        },
        "required": [
          "id_rol",
          "ids_permiso"
        ]
      },
      "seguridadError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensaje": {
                "type": "string"
              },
              "detalles": {
                "type": "array",
                "items": {}
              }
