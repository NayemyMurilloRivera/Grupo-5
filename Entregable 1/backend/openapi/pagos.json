    "/reportes/cuentas-por-cobrar": {
      "get": {
        "operationId": "getReceivablesReport",
        "tags": [
          "pagos"
        ],
        "summary": "Reporte de cuentas por cobrar (GROUP BY/HAVING); formato=csv descarga archivo",
        "description": "Reporte de cuentas por cobrar (GROUP BY/HAVING); formato=csv descarga archivo. Responsable: Rodrigo.",
        "x-owner": "Rodrigo",
        "x-status": "implemented",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "saldoMinimo",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "0.01"
            }
          },
          {
            "name": "formato",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON o CSV con los mismos filtros y totales",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pagosReporte"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Filtros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pagosError"
                }
              }
            }
          },
          "401": {
