  "components": {
    "schemas": {
      "pagosError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensaje": {
                "type": "string"
              },
              "detalles": {
                "type": "array",
                "items": {}
              }
            }
          }
        }
      },
      "pagosMetodo": {
        "type": "object",
        "properties": {
          "id_metodopago": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "nombre": {
            "type": "string"
          }
        }
      },
      "pagosMetodoInput": {
        "type": "object",
        "required": [
          "nombre"
        ],
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "pagosDocumentoInput": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "tipo",
              "serie"
            ],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "const": "boleta"
              },
              "serie": {
                "type": "string"
              },
              "numero": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "nombre_receptor": {
                "type": "string"
              },
              "documento_receptor": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "tipo",
              "serie",
              "razon_social_receptor",
              "ruc_receptor"
            ],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "const": "factura"
              },
              "serie": {
                "type": "string"
              },
              "numero": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "razon_social_receptor": {
                "type": "string"
              },
              "ruc_receptor": {
                "type": "string",
                "pattern": "^[0-9]{11}$"
              }
            }
          }
        ]
      },
      "pagosPagoInput": {
        "type": "object",
        "required": [
          "id_obligacion",
          "id_metodopago",
          "importe"
        ],
        "additionalProperties": false,
        "properties": {
          "id_obligacion": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "id_metodopago": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "importe": {
            "type": "string",
            "description": "Decimal > 0, hasta 2 decimales"
          },
          "referencia": {
            "type": "string",
            "maxLength": 100
          },
          "documento": {
            "$ref": "#/components/schemas/pagosDocumentoInput"
          }
        }
      },
      "pagosPagoCreado": {
        "type": "object",
        "properties": {
          "id_pago": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "fecha_hora": {
            "type": "string"
          },
          "importe": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "saldo_restante": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "documento": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "pagosPago": {
        "type": "object",
        "properties": {
          "id_pago": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "codigo": {
            "type": "string"
          },
          "fecha_hora": {
            "type": "string"
          },
          "importe": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "referencia": {
            "type": "string",
            "nullable": true
          },
          "id_obligacion": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "metodo": {
            "type": "string"
          },
          "id_paciente": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "paciente": {
            "type": "string"
          },
          "comprobante": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "pagosEstadoCuenta": {
        "type": "object",
        "properties": {
          "id_paciente": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "paciente": {
            "type": "string"
          },
          "obligado": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "pagado": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "saldo": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "obligaciones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "pagosComprobante": {
        "type": "object",
        "properties": {
          "tipo": {
            "enum": [
              "boleta",
              "factura"
            ]
          },
          "codigo": {
            "type": "string"
          },
          "serie": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "fecha_emision": {
            "type": "string"
          },
          "receptor": {
            "type": "string"
          },
          "documento_receptor": {
            "type": "string",
            "nullable": true
          },
          "importe": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      },
      "pagosReporte": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id_paciente": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "paciente": {
                  "type": "string"
                },
                "obligaciones": {
                  "type": "string"
                },
                "obligado": {
                  "type": "string",
                  "pattern": "^-?\\d+\\.\\d{2}$"
                },
                "pagado": {
                  "type": "string",
                  "pattern": "^-?\\d+\\.\\d{2}$"
                },
                "saldo": {
                  "type": "string",
                  "pattern": "^-?\\d+\\.\\d{2}$"
                }
              }
            }
          },
          "totales": {
            "type": "object"
          }
        }
      }
    }
  }
}